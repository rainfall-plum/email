# Copy to /etc/email-platform/app.env and chmod 600.
# These values are placeholders for deployment review only.
EMAIL_ENVIRONMENT=production
EMAIL_ALLOWED_DOMAIN=REPLACE_WITH_SINGLE_DOMAIN
EMAIL_DATABASE_URL=sqlite:////var/lib/email-platform/data/database.sqlite
EMAIL_DATA_DIR=/var/lib/email-platform/data
EMAIL_NAMES_DIR=/var/lib/email-platform/data/names
EMAIL_LOG_DIR=/var/log/email-platform
EMAIL_JWT_SECRET_KEY=REPLACE_WITH_32_BYTE_RANDOM_SECRET
EMAIL_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set only during a controlled first-run bootstrap, then remove or rotate.
# EMAIL_BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
# EMAIL_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
